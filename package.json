{
  "name": "dosvy-restaurante",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "depcruise --output-type err src",
    "db:generate": "node --conditions=react-server ./node_modules/drizzle-kit/bin.cjs generate",
    "db:check": "node --conditions=react-server ./node_modules/drizzle-kit/bin.cjs check",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/db-migrate.ts",
    "db:test": "node --conditions=react-server --env-file-if-exists=.env --import tsx --test tests/db/config.test.ts tests/db/transactions.test.ts",
    "db:verify": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/db-verify.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
