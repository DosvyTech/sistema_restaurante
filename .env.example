# Copy to .env for this repository's local PostgreSQL container only.
# Replace this placeholder with a local-only value using URL-safe characters.
POSTGRES_USER=dosvy_local
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=dosvy_dev

DATABASE_URL=postgresql://dosvy_local:replace-with-a-local-only-password@127.0.0.1:55432/dosvy_dev
TEST_DATABASE_URL=postgresql://dosvy_local:replace-with-a-local-only-password@127.0.0.1:55432/dosvy_test
