# Copy this file to an operator-controlled location outside the repository.
DOSVY_INSTALLATION_ID=restaurant_01
DOSVY_COMPOSE_PROJECT=dosvy-restaurant-01
DOSVY_DOMAIN=restaurant.example.com
DOSVY_APP_IMAGE=ghcr.io/dosvytech/sistema_restaurante:release@sha256:REPLACE_WITH_PUBLISHED_IMAGE_DIGEST
DOSVY_POSTGRES_IMAGE=ghcr.io/dosvytech/sistema_restaurante-postgres:18.6-pgbackrest-2.60.0@sha256:REPLACE_WITH_PUBLISHED_IMAGE_DIGEST
DOSVY_CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
DOSVY_DATABASE_NAME=dosvy_restaurant_01
DOSVY_DATABASE_USER=dosvy_owner
DOSVY_DATABASE_URL_FILE=/etc/dosvy/restaurant_01/database_url
DOSVY_POSTGRES_PASSWORD_FILE=/etc/dosvy/restaurant_01/postgres_password
DOSVY_PGBACKREST_CONFIG_FILE=/etc/dosvy/restaurant_01/pgbackrest.conf
DOSVY_DEPLOYMENT_ENV_FILE=/etc/dosvy/restaurant_01/deployment.env
DOSVY_BACKUP_LAST_SUCCESS_FILE=/var/lib/dosvy/restaurant_01/backup-last-success
DOSVY_BACKUP_FAILURE_FLAG_FILE=/var/lib/dosvy/restaurant_01/backup-failed
DOSVY_ALERT_STATE_FILE=/var/lib/dosvy/restaurant_01/alert-state.json
DOSVY_ALERT_WEBHOOK_FILE=/etc/dosvy/restaurant_01/alert-webhook-url
DOSVY_BACKUP_TYPE=full
DOSVY_HTTP_BIND_ADDRESS=0.0.0.0
DOSVY_HTTP_PORT=80
DOSVY_HTTPS_PORT=443
