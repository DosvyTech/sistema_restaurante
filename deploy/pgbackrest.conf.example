# Copy to an operator-owned path outside the repository and set mode 0600.
# Use a private endpoint from an S3-compatible service independent of the VPS.
[global]
repo1-type=s3
repo1-path=/dosvy/restaurant_01
repo1-s3-bucket=dosvy-restaurant-01
repo1-s3-endpoint=s3.example.net
repo1-s3-region=us-east-1
repo1-s3-key=REPLACE_WITH_EXTERNAL_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_EXTERNAL_SECRET_KEY
repo1-s3-uri-style=path
repo1-storage-port=443
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_EXTERNAL_RECOVERY_KEY
repo1-retention-full-type=count
repo1-retention-full=2
start-fast=y
log-level-file=off

[restaurant_01]
pg1-path=/var/lib/postgresql/18/docker
pg1-user=dosvy_owner
